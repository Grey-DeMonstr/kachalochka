import kotlin.Boolean;
import kotlin.time.Instant;

CREATE TABLE profile (
    id           TEXT    NOT NULL PRIMARY KEY,
    user_id      TEXT,
    display_name TEXT,
    updated_at   INTEGER AS Instant NOT NULL,
    deleted      INTEGER AS Boolean NOT NULL DEFAULT 0
);

CREATE INDEX profile_updated_at_idx ON profile (updated_at);

upsert:
INSERT OR REPLACE INTO profile(id, user_id, display_name, updated_at, deleted)
VALUES (?, ?, ?, ?, ?);

byId:
SELECT id, user_id, display_name, updated_at, deleted FROM profile WHERE id = ?;

import kotlin.Boolean;
import kotlin.time.Instant;

CREATE TABLE profile (
    id            TEXT    NOT NULL PRIMARY KEY,
    user_id       TEXT,
    display_name  TEXT,
    updated_at    INTEGER AS Instant NOT NULL,
    deleted       INTEGER AS Boolean NOT NULL DEFAULT 0,
    -- In the order 8.sqm rebuilds the table with, then the columns later migrations add.
    friend_colors TEXT    NOT NULL DEFAULT '{}',
    sex           TEXT,
    birth_date    TEXT,
    height_cm     REAL,
    weight_unit   TEXT    NOT NULL DEFAULT 'kg',
    group_by_tag  INTEGER AS Boolean NOT NULL DEFAULT 0,
    avatar_photo  TEXT
);

CREATE INDEX profile_updated_at_idx ON profile (updated_at);

upsert:
INSERT OR REPLACE INTO profile(
    id, user_id, display_name, updated_at, deleted, friend_colors, sex, birth_date, height_cm,
    weight_unit, group_by_tag, avatar_photo
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

byId:
SELECT * FROM profile WHERE id = ?;

forOwner:
SELECT * FROM profile
WHERE deleted = 0 AND ((:owner IS NULL AND user_id IS NULL) OR user_id = :owner)
ORDER BY updated_at DESC, id DESC
LIMIT 1;

ownerlessIds:
SELECT id FROM profile WHERE user_id IS NULL;

-- Keeps updated_at: a fresh stamp would rank an anonymous profile above the account's own.
claimOwnerless:
UPDATE profile SET user_id = :owner WHERE user_id IS NULL;

purgeOwner:
DELETE FROM profile WHERE user_id = ?;

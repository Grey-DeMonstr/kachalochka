CREATE TABLE measure (
    id         TEXT NOT NULL PRIMARY KEY,
    user_id    TEXT,
    name       TEXT NOT NULL,
    unit       TEXT NOT NULL DEFAULT '',
    kind       TEXT,
    position   INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL,
    deleted    INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX measure_updated_at_idx ON measure (updated_at);

CREATE TABLE measurement (
    id         TEXT NOT NULL PRIMARY KEY,
    user_id    TEXT,
    measure_id TEXT NOT NULL,
    day        TEXT NOT NULL,
    value      REAL NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted    INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX measurement_updated_at_idx ON measurement (updated_at);

-- Measures other devices wrote may be older than the watermark the other tables advanced.
UPDATE syncState SET lastPullAt = NULL;

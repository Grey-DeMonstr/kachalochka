import kotlin.Boolean;
import kotlin.time.Instant;

CREATE TABLE visit (
    id          TEXT    NOT NULL PRIMARY KEY,
    user_id     TEXT,
    recorded_at INTEGER AS Instant NOT NULL,
    ended_at    INTEGER AS Instant,
    updated_at  INTEGER AS Instant NOT NULL,
    deleted     INTEGER AS Boolean NOT NULL DEFAULT 0
);

CREATE INDEX visit_updated_at_idx ON visit (updated_at);

upsert:
INSERT OR REPLACE INTO visit(id, user_id, recorded_at, ended_at, updated_at, deleted)
VALUES (?, ?, ?, ?, ?, ?);

byId:
SELECT * FROM visit WHERE id = ?;

active:
SELECT * FROM visit
WHERE ended_at IS NULL AND deleted = 0
  AND ((:owner IS NULL AND user_id IS NULL) OR user_id = :owner)
ORDER BY recorded_at DESC LIMIT 1;

forOwner:
SELECT * FROM visit
WHERE deleted = 0
  AND ((:owner IS NULL AND user_id IS NULL) OR user_id = :owner)
ORDER BY recorded_at DESC;

ownerlessIds:
SELECT id FROM visit WHERE user_id IS NULL;

claimOwnerless:
UPDATE visit SET user_id = :owner, updated_at = :updatedAt WHERE user_id IS NULL;

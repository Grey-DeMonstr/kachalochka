import kotlin.Boolean;
import kotlin.time.Instant;

CREATE TABLE machine (
    id                TEXT    NOT NULL PRIMARY KEY,
    user_id           TEXT,
    name              TEXT    NOT NULL,
    setup_note        TEXT    NOT NULL DEFAULT '',
    weight_mode       TEXT    NOT NULL,
    platform_weight   REAL    NOT NULL DEFAULT 0,
    platform_included INTEGER AS Boolean NOT NULL DEFAULT 0,
    unit              TEXT    NOT NULL,
    weight_step       REAL    NOT NULL,
    updated_at        INTEGER AS Instant NOT NULL,
    deleted           INTEGER AS Boolean NOT NULL DEFAULT 0,
    -- Last, where 2.sqm's ALTER TABLE puts it.
    unit_label        TEXT    NOT NULL DEFAULT '',
    -- Where 4.sqm's ALTER TABLE puts it. Never read: links live in machine_link.
    link_id           TEXT,
    -- Last, where 12.sqm's ALTER TABLE puts it: a JSON array.
    tags              TEXT    NOT NULL DEFAULT '[]',
    -- Last, where 16.sqm's ALTER TABLE puts it.
    cover_photo       TEXT
);

CREATE INDEX machine_updated_at_idx ON machine (updated_at);

upsert:
INSERT OR REPLACE INTO machine(id, user_id, name, setup_note, weight_mode, platform_weight,
    platform_included, unit, weight_step, updated_at, deleted, unit_label, tags, cover_photo)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

byId:
SELECT * FROM machine WHERE id = ?;

live:
SELECT * FROM machine
WHERE deleted = 0 AND ((:owner IS NULL AND user_id IS NULL) OR user_id = :owner);

named:
SELECT * FROM machine
WHERE deleted = 0 AND name = :name
  AND ((:owner IS NULL AND user_id IS NULL) OR user_id = :owner)
LIMIT 1;

ownerlessIds:
SELECT id FROM machine WHERE user_id IS NULL;

claimOwnerless:
UPDATE machine SET user_id = :owner, updated_at = :updatedAt WHERE user_id IS NULL;

purgeOwner:
DELETE FROM machine WHERE user_id = ?;

import kotlin.Boolean;
import kotlin.time.Instant;
import monster.greyde.kachalochka.core.domain.gym.CalendarDay;

CREATE TABLE measurement (
    id         TEXT NOT NULL PRIMARY KEY,
    user_id    TEXT,
    measure_id TEXT NOT NULL,
    day        TEXT AS CalendarDay NOT NULL,
    value      REAL NOT NULL,
    updated_at INTEGER AS Instant NOT NULL,
    deleted    INTEGER AS Boolean NOT NULL DEFAULT 0
);

CREATE INDEX measurement_updated_at_idx ON measurement (updated_at);

upsert:
INSERT OR REPLACE INTO measurement(id, user_id, measure_id, day, value, updated_at, deleted)
VALUES (?, ?, ?, ?, ?, ?, ?);

byId:
SELECT * FROM measurement WHERE id = ?;

everyRowOf:
SELECT * FROM measurement
WHERE (:owner IS NULL AND user_id IS NULL) OR user_id = :owner;

ownerlessIds:
SELECT id FROM measurement WHERE user_id IS NULL;

claimOwnerless:
UPDATE measurement SET user_id = :owner, updated_at = :updatedAt WHERE user_id IS NULL;

purgeOwner:
DELETE FROM measurement WHERE user_id = ?;

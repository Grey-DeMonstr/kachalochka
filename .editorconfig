root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 99
ktlint_function_naming_ignore_when_annotated_with = Composable, Test
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.md]
max_line_length = 99
